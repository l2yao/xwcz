<view class="page">
  <view class="title">影音</view>
  <view wx:for="{{categories}}" wx:key="id" class="card" bindtap="loadAlbums" data-id="{{item.id}}">
    <view class="card-body">{{item.title}}</view>
  </view>
  <view wx:for="{{albums}}" wx:key="id" class="card" bindtap="goAlbum" data-id="{{item.id}}">
    <image class="card-image" mode="aspectFill" src="{{item.cover || fallbackCover}}" />
    <view class="card-body">
      <view>{{item.title}}</view>
      <view class="muted">{{item.total}} 集</view>
    </view>
  </view>
</view>
