page {
  background: #f6f7f4;
  color: #1f2721;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang TC", "Microsoft JhengHei", sans-serif;
}

.page {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #dfe4da;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-image {
  height: 320rpx;
  width: 100%;
}

.card-body {
  padding: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.muted {
  color: #677268;
  font-size: 26rpx;
}
